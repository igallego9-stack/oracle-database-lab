# config/.env.example — plantilla. SÍ se versiona. NUNCA pongas aquí valores reales.
# Copia este archivo a config/.env y rellena contraseñas reales.
# Política de Oracle: mínimo 8 caracteres, con mayúscula, minúscula y número.
# Evita los caracteres @ / " y espacios: rompen la cadena de conexión usuario/clave@host.
ORACLE_PWD=change_me
APP_USER_PWD=change_me_too
ORDS_PUBLIC_PWD=change_me_ords
